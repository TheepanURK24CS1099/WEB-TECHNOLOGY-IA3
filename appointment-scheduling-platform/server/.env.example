# Port for Express server to listen on
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example for local MongoDB: mongodb://localhost:27017/appointment_scheduler
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/appointment_scheduler?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/appointment_scheduler

# Frontend URL for CORS configuration
CLIENT_URL=http://localhost:5173
